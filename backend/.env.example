PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ace_freshers?retryWrites=true&w=majority

# DNS Setting (Fixes querySrv ECONNREFUSED on local networks)
USE_CUSTOM_DNS=true

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=your_email@example.com

# URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
